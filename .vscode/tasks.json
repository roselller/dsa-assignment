{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make: build",
            "type": "shell",
            "command": "make",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "make: test",
            "type": "shell",
            "command": "make test",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "make: test with sanitizers",
            "type": "shell",
            "command": "make asan",
            "problemMatcher": ["$gcc"],
            "group": "test"
        },
        {
            "label": "run: web server",
            "type": "shell",
            "command": "make run-web",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "run: terminal client",
            "type": "shell",
            "command": "make run",
            "presentation": { "focus": true },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Task generated by Debugger. Only suitable for a single self-contained file; use \"make: build\" for this project."
        }
    ]
}
